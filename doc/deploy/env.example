# Secrets for paperless-rearchive (copy to .env.paperless-rearchive next to
# your docker-compose.yml, or use as compose `env_file`).
#
# EVERYTHING ELSE lives in the compose service's `environment:` block — see
# the "Setup (docker compose)" section of README.md for the full list with
# defaults. This file is for secrets only.
#
# Alternative: every credential can instead be supplied as a file via the
# paperless-ngx `_FILE` convention (e.g. PAPERLESS_API_TOKEN_FILE=/run/secrets/
# paperless_api_token) — the _FILE variant wins when both are set.

# --- paperless-ngx -----------------------------------------------------------
PAPERLESS_API_TOKEN=change-me

# --- Chandra inference server (omit if the server needs no auth) -------------
PAPERLESS_CHANDRA_API_KEY=change-me

# --- PostgreSQL (re-ocr-all only; copy from paperless's own environment) -----
PAPERLESS_DBPASS=change-me

