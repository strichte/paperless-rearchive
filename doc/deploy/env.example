# Secrets for paperless-rearchive — Way 1 example: plain values.
#
# Reference this file from the service via compose `env_file:` (see the
# "Secrets" section of README.md). Everything else lives in the compose
# service's `environment:` block.
#
# The same credentials can instead be supplied via _FILE variables pointing
# at files (e.g. docker secrets) — the _FILE variant wins when both are set.
# All four credentials support both mechanisms, API token included.

# --- paperless-ngx -----------------------------------------------------------
PAPERLESS_API_TOKEN=change-me

# --- Chandra inference server (omit if the server needs no auth) -------------
PAPERLESS_CHANDRA_API_KEY=change-me

# --- PostgreSQL (re-ocr-all only; copy from paperless's own environment) -----
PAPERLESS_DBPASS=change-me

