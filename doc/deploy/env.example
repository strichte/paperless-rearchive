# paperless-rearchive environment (.env.paperless-rearchive)
# Copy to paperless-lxc/.env.paperless-rearchive and fill in.
#
# SECRETS: every credential can be given inline (<VAR>=...) here OR as a
# path to a secret file (<VAR>_FILE=...) in the compose file (paperless-ngx
# convention). The _FILE variant wins when both are set.

# --- paperless-ngx ---------------------------------------------------------
PAPERLESS_BASE_URL=http://paperless:8000
PAPERLESS_API_TOKEN=change-me   # e.g. the token from .env.paperless-gpt
# Alternative: PAPERLESS_API_TOKEN_FILE=/run/secrets/paperless_api_token (set in compose)

# --- trigger / outcome tags ------------------------------------------------
REARCHIVE_TRIGGER_TAG_CONTENT=re-ocr-content
REARCHIVE_TRIGGER_TAG_ALL=re-ocr-all
REARCHIVE_SUCCESS_SUFFIX=-success
REARCHIVE_FAILURE_SUFFIX=-failure

# --- OCR provider (Chandra) ------------------------------------------------
REARCHIVE_PROVIDER=chandra
PAPERLESS_CHANDRA_SERVER_URL=http://ai:8110/v1
PAPERLESS_CHANDRA_MODEL_NAME=chandra-ocr-2-q8
PAPERLESS_CHANDRA_CONTENT_FORMAT=markdown
# API key inline, or via secret file in compose:
#   PAPERLESS_CHANDRA_API_KEY=change-me
#   PAPERLESS_CHANDRA_API_KEY_FILE=/run/secrets/chandra_api_key   (set in compose)
# PAPERLESS_CHANDRA_MAX_OUTPUT_TOKENS=12384

# --- OCR options -----------------------------------------------------------
REARCHIVE_OCR_LANGUAGE=eng
REARCHIVE_OCR_DESKEW=true
REARCHIVE_OCR_OUTPUT_TYPE=pdfa
# Mirror paperless's PAPERLESS_OCR_USER_ARGS, e.g.:
# REARCHIVE_OCR_USER_ARGS={"invalidate_digital_signatures": true, "continue_on_soft_render_error": true}
REARCHIVE_MAX_PAGES=0

# --- sidecar loop ----------------------------------------------------------
REARCHIVE_ARCHIVE_DIR=/archives
REARCHIVE_POLL_INTERVAL=300
REARCHIVE_BATCH_LIMIT=5
REARCHIVE_OCR_CONCURRENCY=2
REARCHIVE_DRY_RUN=false
REARCHIVE_RUN_ONCE=false
REARCHIVE_LOG_LEVEL=INFO

# --- database (re-ocr-all only) -------------------------------------------
# DB host/name are plain values; user/password support the _FILE convention:
#   PAPERLESS_DBUSER=paperless            (or PAPERLESS_DBUSER_FILE=...)
#   PAPERLESS_DBPASS=change-me            (or PAPERLESS_DBPASS_FILE=/run/secrets/...)
# PAPERLESS_DBHOST/PAPERLESS_DBNAME/PAPERLESS_DBUSER/PAPERLESS_DBPASS_FILE
# are set in the compose snippet.
